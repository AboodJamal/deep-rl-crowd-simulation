# ============================================
# DRL vs VGA Comparison Project - .gitignore
# ============================================

# ==================
# Python
# ==================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
dist/
build/

# ==================
# Virtual Environments
# ==================
.venv/
venv/
venv_*/
env/
ENV/

# ==================
# Jupyter Notebooks
# ==================
.ipynb_checkpoints/

# ==================
# IDEs
# ==================
.vscode/
.idea/
*.swp
*.swo

# ==================
# OS Files
# ==================
.DS_Store
Thumbs.db
nul

# ==================
# Weights & Biases (Large training logs - regenerable)
# ==================
wandb/

# ==================
# Training Logs (regenerable)
# ==================
logs/
*.log

# ==================
# Temporary files
# ==================
*.tmp
*.bak
*.orig

# ==================
# Archive folders (old/unused experiments)
# ==================
_archive/
vga_baseline/archive/
vga_baseline/archive.rar
docs